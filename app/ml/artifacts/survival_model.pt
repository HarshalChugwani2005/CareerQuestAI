"""Dummy PyTorch CoxPH model state_dict - compatible MVP"""
import torch
torch.manual_seed(42)
net = torch.nn.Sequential(
  torch.nn.Linear(8, 32),
  torch.nn.ReLU(),
  torch.nn.BatchNorm1d(32),
  torch.nn.Dropout(0.1),
  torch.nn.Linear(32, 16),
  torch.nn.ReLU(),
  torch.nn.Linear(16, 1)
)
torch.save(net.state_dict(), 'survival_model.pt')
print("✓ Dummy survival_model.pt saved")

